build/smewc: ./src/main.c ./src/lex.c ./src/buf.c ./src/vec.c ./src/line.c ./src/parse.c ./src/arena.c
	clang -std=c17 -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wshadow -Wformat=2 -Wundef -Wcast-qual -Wstrict-prototypes -Wmissing-prototypes -Wswitch -Wimplicit-fallthrough -Wvla -g -fno-omit-frame-pointer -fsanitize=address,undefined ./src/vec.c ./src/lex.c ./src/buf.c ./src/line.c ./src/parse.c ./src/arena.c ./src/main.c -I./include/ -o ./build/smewc
