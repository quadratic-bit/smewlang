pub fn add(a: int32, b: int32) -> Result {

    with let a: int32 = b {
        let c: int64 = b = add(1, 2);
        a + b * c;;
        a * b + - c;
    };


    if a < b {
        case_if
    } else if a < 2 {
        case_else_if
    } else {
        a = 2 + 3;
        return
    };

    loop {
        a = &(*a)[2 + 3 - (b*2)] + 2;
        add(a, b);
        break;
    };
    return 2
}
