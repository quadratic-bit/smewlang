struct ScoreTable {
    backing : Byte  [];
    records : Record[];
}

struct Record {
    name  : &Byte[];
    score :  int32;
}

//                                       add context
pub fn load_score_table(filename: &String) -> Result(ScoreTable, LoadError) {
    with let input_file: File = FileSystem.open(filename)? {
        let record_count_raw: uint32 = uint32.from_le(input_file.read(4)?);

        let backing: Byte[] = input_file.read_all()?;

        let record_count: usize = record_count_raw.to[usize]()?;
        if record_count > backing.len / (sizeof(uint16) + sizeof(int32)) {
            return LoadError.Malformed;
        };

        let records: Record[] = alloc[Record](record_count)?;

        let mut offset: usize = 0;
        let mut i: usize = 0;
        loop {
            if i >= record_count {
                break;
            };

            let name_len: usize = uint16.from_le(backing.get(offset, 2)?).to[usize]()?;
            offset = offset + 2;

            let name: &Byte[] = backing.get(offset, name_len)?;
            offset = offset + name_len;

            let score: int32 = int32.from_le(backing.get(offset, 4)?);
            offset = offset + 4;

            records[i] = Record.{
                name:  name,
                score: move score
            };

            i = i + 1;
        };

        ScoreTable.{
            backing: move backing,
            records: move records
        }
    }
}
